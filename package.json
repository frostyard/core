{
  "name": "@frostyard/core-validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "npm run verify",
    "verify": "npm run check:docs && npm run check:organization && npm run check:scripts && npm run check:corrections && npm run check:risk-paths && npm test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:organization": "node scripts/check-organization.mjs",
    "check:fleet": "node scripts/check-fleet-conventions.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:corrections": "node scripts/check-corrections.mjs",
    "check:risk-paths": "node scripts/check-risk-paths.mjs",
    "check:secret-expiry": "node scripts/check-secret-expiry.mjs",
    "check:instructions": "node scripts/check-instructions.mjs",
    "check:stable-repository": "node scripts/check-stable-repository.mjs",
    "report:corrections": "node scripts/corrections-report.mjs",
    "test": "node --test test/*.test.mjs",
    "sync:risk-paths-workflow": "node scripts/sync-risk-paths-workflow.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  }
}
