{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frostyard.org/schemas/organization/v1/repository-settings.schema.json",
  "title": "Frostyard repository settings contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "repository",
    "actions",
    "security",
    "default_branch_ruleset",
    "tag_ruleset",
    "metadata",
    "labels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "const": "repository-settings"
        },
        "version": {
          "const": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delete_branch_on_merge",
        "allow_update_branch",
        "allow_auto_merge",
        "allow_merge_commit",
        "allow_squash_merge",
        "allow_rebase_merge",
        "merge_commit_title",
        "merge_commit_message",
        "squash_merge_commit_title",
        "squash_merge_commit_message",
        "has_wiki",
        "has_projects",
        "has_issues",
        "web_commit_signoff_required"
      ],
      "properties": {
        "delete_branch_on_merge": { "type": "boolean" },
        "allow_update_branch": { "type": "boolean" },
        "allow_auto_merge": { "type": "boolean" },
        "allow_merge_commit": { "type": "boolean" },
        "allow_squash_merge": { "type": "boolean" },
        "allow_rebase_merge": { "type": "boolean" },
        "merge_commit_title": { "enum": ["PR_TITLE", "MERGE_MESSAGE"] },
        "merge_commit_message": { "enum": ["PR_TITLE", "PR_BODY", "BLANK"] },
        "squash_merge_commit_title": { "enum": ["PR_TITLE", "COMMIT_OR_PR_TITLE"] },
        "squash_merge_commit_message": { "enum": ["PR_BODY", "COMMIT_MESSAGES", "BLANK"] },
        "has_wiki": { "type": "boolean" },
        "has_projects": { "type": "boolean" },
        "has_issues": { "type": "boolean" },
        "web_commit_signoff_required": { "type": "boolean" }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_workflow_permissions", "can_approve_pull_request_reviews"],
      "properties": {
        "default_workflow_permissions": { "enum": ["read", "write"] },
        "can_approve_pull_request_reviews": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vulnerability_alerts",
        "dependabot_security_updates",
        "secret_scanning",
        "secret_scanning_push_protection",
        "private_vulnerability_reporting"
      ],
      "properties": {
        "vulnerability_alerts": { "type": "boolean" },
        "dependabot_security_updates": { "type": "boolean" },
        "secret_scanning": { "type": "boolean" },
        "secret_scanning_push_protection": { "type": "boolean" },
        "private_vulnerability_reporting": { "type": "boolean" }
      }
    },
    "default_branch_ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enforcement",
        "bypass_actors",
        "require_pull_request",
        "required_approving_review_count",
        "require_conversation_resolution",
        "require_status_checks",
        "strict_required_status_checks",
        "block_deletions",
        "block_force_pushes",
        "merge_queue",
        "classic_branch_protection"
      ],
      "properties": {
        "enforcement": { "const": "active" },
        "bypass_actors": { "const": "none" },
        "require_pull_request": { "type": "boolean" },
        "required_approving_review_count": { "type": "integer", "minimum": 0, "maximum": 6 },
        "require_conversation_resolution": { "type": "boolean" },
        "require_status_checks": { "type": "boolean" },
        "strict_required_status_checks": { "type": "boolean" },
        "block_deletions": { "type": "boolean" },
        "block_force_pushes": { "type": "boolean" },
        "merge_queue": { "const": false },
        "classic_branch_protection": { "const": "absent" }
      }
    },
    "tag_ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "enforcement", "block_deletions", "block_force_pushes", "restrict_creation"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1, "maxLength": 100 },
        "enforcement": { "const": "active" },
        "block_deletions": { "type": "boolean" },
        "block_force_pushes": { "type": "boolean" },
        "restrict_creation": { "type": "boolean" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_required", "description_required", "topics_include"],
      "properties": {
        "license_required": { "type": "boolean" },
        "description_required": { "type": "boolean" },
        "topics_include": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$" }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 50 }
        }
      }
    }
  }
}
