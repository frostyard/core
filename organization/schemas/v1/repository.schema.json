{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frostyard.org/schemas/organization/v1/repository.schema.json",
  "title": "Frostyard repository declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "accountable_owners",
    "fleet_state",
    "maintenance_programs",
    "action_ceiling",
    "surface_contract_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "repository_id"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    },
    "accountable_owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "login"],
            "properties": {
              "kind": {
                "const": "github-user"
              },
              "login": {
                "type": "string",
                "minLength": 1,
                "maxLength": 39,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "slug"],
            "properties": {
              "kind": {
                "const": "github-team"
              },
              "slug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,99})$"
              }
            }
          }
        ]
      }
    },
    "fleet_state": {
      "enum": ["enabled", "paused", "disabled"]
    },
    "maintenance_programs": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quality",
          "ci",
          "security",
          "architecture",
          "conformance",
          "triage",
          "dependencies",
          "docs",
          "release"
        ]
      }
    },
    "action_ceiling": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "write",
          "run-tests",
          "open-issue",
          "open-pr",
          "create-followup"
        ]
      }
    },
    "surface_contract_version": {
      "const": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fleet_state": {
            "const": "enabled"
          }
        },
        "required": ["fleet_state"]
      },
      "then": {
        "properties": {
          "maintenance_programs": {
            "type": "array",
            "minItems": 1
          },
          "action_ceiling": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
